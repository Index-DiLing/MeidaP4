# =============================================================================
# MeidaP4 · 探测阶段公共基线
#
# ⚠️ 本工程不要用根目录的 sdkconfig，也不要跑裸 `idf.py build`。
#    构建命令（见 docs/probe-contract.md §5）：
#      idf.py -B build-<slot>-<mode> -D SDKCONFIG=sdkconfig.<slot>-<mode> \
#             -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.<mode>.defaults" build
#    或直接：pwsh -File tools/build.ps1 -Mode a -Slot main
# =============================================================================

CONFIG_IDF_TARGET="esp32p4"

# ---- Flash: 32 MB（hello_p4 实测板载） ----
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# ---- PSRAM: 32 MB @ 250 MHz，Hex 模式（hello_p4 实测） ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# ---- CPU ----
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y

# ---- 分区表：自定义（plan §4.5；hello_p4 的 SINGLE_APP 只给 app ~1MB，装不下） ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- FATFS（MTP 探测卷；中文文件名 UTF-8 + CP936，按 plan §4.2） ----
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_CODEPAGE_936=y
CONFIG_FATFS_VOLUME_COUNT=2
CONFIG_FATFS_SECTOR_4096=y
CONFIG_FATFS_PER_FILE_CACHE=y

# ---- USB 设备栈（espressif/esp_tinyusb 2.3.0） ----
# VID/PID 在这里只是给"默认设备描述符"用的兜底；探测固件由 usb_probe 自带设备描述符。
CONFIG_TINYUSB_DESC_USE_ESPRESSIF_VID=y
CONFIG_TINYUSB_DESC_USE_DEFAULT_PID=n
CONFIG_TINYUSB_DESC_CUSTOM_PID=0x4001
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="MeidaP4"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="MeidaP4 Probe"
CONFIG_TINYUSB_DESC_SERIAL_STRING="PROBE-0001"

# 探测期不用 MSC / CDC / 网络
CONFIG_TINYUSB_MSC_ENABLED=n
CONFIG_TINYUSB_CDC_ENABLED=n
CONFIG_TINYUSB_NET_MODE_NONE=y

# Vendor 接口：count=1，EP 512（HS 最小合法值），软件 FIFO 4 KB 便于测吞吐
CONFIG_TINYUSB_VENDOR_COUNT=1
CONFIG_TINYUSB_VENDOR_EPSIZE=512
CONFIG_TINYUSB_VENDOR_RX_BUFSIZE=4096
CONFIG_TINYUSB_VENDOR_TX_BUFSIZE=4096
