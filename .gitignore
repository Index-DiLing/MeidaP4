# macOS
.DS_Store
.AppleDouble
.LSOverride

# Directory metadata
.directory

# Temporary files
*~
*.swp
*.swo
*.bak
*.tmp

# Log files
*.log

# Build artifacts and directories
**/build/
build/
*.o
*.a
*.out
*.exe # For any host-side utilities compiled on Windows

# ESP-IDF specific build outputs
*.bin
*.elf
*.map
flasher_args.json # Generated in build directory
sdkconfig.old
sdkconfig
# Probe phase: each writer uses its own generated sdkconfig and build dir.
# Keep the tracked defaults files (sdkconfig.defaults, sdkconfig.<mode>.defaults).
sdkconfig.*
!sdkconfig.defaults
!sdkconfig.*.defaults
sdkconfig.template-backup
# Per-writer build directories (build-a, build-b, build-usbcore-b, ...)
build-*/
build.*.bak/

# Probe-phase archive: keep the README/index, ignore the bulk artifacts.
archive/*/builds/
archive/*/sdkconfigs/
archive/*/reference-components/

# ESP-IDF dependencies
# For older versions or manual component management
/components/.idf/
**/components/.idf/
# For modern ESP-IDF component manager
managed_components/
# If ESP-IDF tools are installed/referenced locally to the project
.espressif/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake

# Python environment files
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
dist/

# Virtual environment folders
venv/
.venv/
env/

# Language Servers
.clangd/
.ccls-cache/
compile_commands.json

# Windows specific
Thumbs.db
ehthumbs.db
Desktop.ini

# User-specific configuration files
*.user
*.workspace # General workspace files, can be from various tools
*.suo       # Visual Studio Solution User Options
*.sln.docstates # Visual Studio

# ---------------------------------------------------------------------------
# T2 起新增（画面显示 + 共享 TF 卡）
# ---------------------------------------------------------------------------
# 验收/调试工具的默认输出目录（视频帧、拉下来的文件、MTP 测试文件）
out/

# build.ps1 的"sdkconfig 生成来源"时间戳（每个槽位一个，纯生成物）
*.defaults-stamp

# 真机串口抓取（tools/serial_capture.py --out build-*/serial-*.log 已含在上面的 build-*/ 里，
# 这里兜住直接写在根目录的情形）
serial-*.log

# 临时回放/诊断脚本（真机排查期间生成的单次脚本，不应入库）
_dbg_*.py
_dbg_*.mjs
_crc_check.py

# 归档目录里的烧写镜像（体积大且可由 build.ps1 复现；需要入库请 git add -f）
archive/*/*.bin
archive/*/*.elf